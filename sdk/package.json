{
  "name": "@tangle-network/llm-inference-sdk",
  "version": "1.0.0",
  "description": "Client SDK for the Tangle vLLM inference blueprint with ShieldedCredits billing (viem)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wagmi": {
      "types": "./dist/wagmi.d.ts",
      "import": "./dist/wagmi.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "node scripts/onchain-e2e.mjs --http-peer",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@wagmi/core": "^2.0.0",
    "viem": "^2.21.0"
  },
  "peerDependenciesMeta": {
    "@wagmi/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@wagmi/core": "^2.16.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0",
    "viem": "2.49.0",
    "oxc-parser": "^0.155.0"
  },
  "files": [
    "dist/",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "dependencies": {
    "@tangle-network/tcloud": "^1.0.4"
  },
  "packageManager": "pnpm@12.18.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangle-network/llm-inference-blueprint.git",
    "directory": "sdk"
  }
}
